# Copia este archivo como .env (en esta misma carpeta) y completa lo que necesites.
# Lo usan el backend (go run), el frontend (pnpm dev) y docker compose.
# Todas las variables son opcionales; estos son los valores por defecto.

# ---------- Backend ----------
PORT=8080
DATA_DIR=data
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Cámbialo fuera de local.
JWT_SECRET=dev-secret-change-me
JWT_TTL=8h

AUTH_EMAIL=admin@energia.local
AUTH_PASSWORD=admin123
AUTH_NAME=Operador

# OpenAI redacta las explicaciones de Run AI Analysis.
# Sin OPENAI_API_KEY se usa el texto determinístico del motor.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=30s

# ---------- Frontend (solo desarrollo) ----------
# URL del backend para el proxy de desarrollo de Vite (/api -> backend).
VITE_API_PROXY_TARGET=http://localhost:8080
